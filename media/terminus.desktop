[Desktop Entry]
Type=Application
Name=Terminus
GenericName=Editor e terminal
Comment=Uma ponte amigável para o terminal do Linux — Neovim com casca clicável
Exec=terminus %f
Icon=terminus
Terminal=false
Categories=Development;IDE;
MimeType=text/plain;text/x-python;
# O Plasma casa a janela ao lançador por esta chave — sem ela, a barra de
# tarefas mostra um ícone genérico mesmo com a janela tendo ícone próprio.
StartupWMClass=Terminus
Keywords=neovim;editor;terminal;codigo;
