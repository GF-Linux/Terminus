{
  "name": "bancada",
  "productName": "Bancada",
  "description": "Ambiente de análise para quem é alfabetizado em Python e trabalha com dado biológico.",
  "version": "0.1.0",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "author": "Gustavo Freitas",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc --noEmit && electron-vite build",
    "start": "electron-vite preview",
