{
  "name": "terminus",
  "productName": "Terminus",
  "description": "Uma ponte amigável para o terminal do Linux: casca clicável com o Neovim como motor.",
  "version": "0.0.8",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "author": "Gustavo Freitas",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc --noEmit && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "teste": "node --import ./tests/apoio/gancho-de-modulos.ts --test \"tests/**/*.test.ts\"",
    "portao": "node ferramentas/portao.mjs",
    "orfaos": "python3 ferramentas/varre-orfaos.py"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "neovim": "^5.4.0",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@msgpack/msgpack": "2.8.0",
    "@types/node": "^22.10.5",
    "electron": "^33.3.1",
    "electron-vite": "^2.3.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.21.5": true
  }
}
